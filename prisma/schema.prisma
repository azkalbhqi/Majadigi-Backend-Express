model HealthUser {
  id                String  @id @default(uuid())
  userId            String  @unique
  noBpjs            String?
  bloodType         String?
  vaccinationStatus String?

  user User @relation(fields: [userId], references: [id])
}

// --- HOSPITAL & SERVICES ---

model RumahSakit {
  id      Int    @id @default(autoincrement())
  name    String
  city    String
  type    String
  address String
  phone   String

  // Service Relations
  medicalRecords MedicalRecord[]
}

// --- MEDICAL INFORMATION SYSTEM (As per Image) ---

model MedicalRecord {
  id           String   @id @default(uuid())
  userId       String
  rumahSakitId Int
  dokter       String
  keluhan      String   @db.Text
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id])
  rumahSakit RumahSakit @relation(fields: [rumahSakitId], references: [id])
}

