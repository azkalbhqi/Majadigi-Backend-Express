generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                     String                   @id
  name                   String
  email                  String                   @unique
  phoneNumber            String?
  password               String
  address                String?
  latitude               Decimal?
  longitude              Decimal?
  birthDate              DateTime?
  role                   String                   @default("PATIENT")
  createdAt              DateTime                 @default(now())
  imageUrl               String?
  activities             Activity[]
  healthProfile          HealthUser?
  medicalRecords         MedicalRecord[]
  pendaftaranDahaHusada  PendaftaranDahaHusada[]
  pendaftaranHajiJatim   PendaftaranHajiJatim[]
  pendaftaranKarsahusada PendaftaranKarsahusada[]
  pendaftaranSaifulAnwar PendaftaranSaifulAnwar[]
  pendaftaranSoetomo     PendaftaranSoetomo[]
  pendaftaranAmbulansSoetomo PendaftaranAmbulansSoetomo[]
  tbcScreenings          SkriningTbc[]
  notifications          Notification[]
}

model HealthUser {
  id                String  @id @default(uuid())
  userId            String  @unique
  noBpjs            String?
  bloodType         String?
  vaccinationStatus String?
  tbcStatus         String?
  user              User    @relation(fields: [userId], references: [id])
}

model RumahSakit {
  id             Int             @id @default(autoincrement())
  name           String
  url            String?
  image          String?
  address        String
  deskripsi      String?
  city           String?
  phone          String?
  type           String?
  medicalRecords MedicalRecord[]
}

model MedicalRecord {
  id           String     @id @default(uuid())
  userId       String
  rumahSakitId Int
  dokter       String
  keluhan      String
  createdAt    DateTime   @default(now())
  rumahSakit   RumahSakit @relation(fields: [rumahSakitId], references: [id])
  user         User       @relation(fields: [userId], references: [id])
}

model SkriningTbc {
  id              Int      @id @default(autoincrement())
  userId          String
  screeningResult String
  screeningDate   DateTime @default(now())
  coughDuration   Int
  fever           Boolean
  nightSweat      Boolean
  weightLoss      Boolean
  user            User     @relation(fields: [userId], references: [id])
}

model PendaftaranSoetomo {
  id             String     @id @default(uuid())
  userId         String
  tipePasien     TipePasien
  nomorIdentitas String
  tanggalLahir   DateTime
  asalRujukan    String?
  status         String     @default("PENDING")
  createdAt      DateTime   @default(now())
  user           User       @relation(fields: [userId], references: [id])
}

model PendaftaranHajiJatim {
  id             String     @id @default(uuid())
  userId         String
  tipePasien     TipePasien
  nomorIdentitas String
  tanggalLahir   DateTime
  asalRujukan    String?
  status         String     @default("PENDING")
  createdAt      DateTime   @default(now())
  user           User       @relation(fields: [userId], references: [id])
}

model PendaftaranKarsahusada {
  id             String     @id @default(uuid())
  userId         String
  tipePasien     TipePasien
  nomorIdentitas String
  tanggalLahir   DateTime
  asalRujukan    String?
  status         String     @default("PENDING")
  createdAt      DateTime   @default(now())
  user           User       @relation(fields: [userId], references: [id])
}

model PendaftaranSaifulAnwar {
  id             String     @id @default(uuid())
  userId         String
  tipePasien     TipePasien
  nomorIdentitas String
  tanggalLahir   DateTime
  asalRujukan    String?
  status         String     @default("PENDING")
  createdAt      DateTime   @default(now())
  user           User       @relation(fields: [userId], references: [id])
}

model PendaftaranDahaHusada {
  id             String     @id @default(uuid())
  userId         String
  tipePasien     TipePasien
  nomorIdentitas String
  tanggalLahir   DateTime
  asalRujukan    String?
  status         String     @default("PENDING")
  createdAt      DateTime   @default(now())
  user           User       @relation(fields: [userId], references: [id])
}

model Activity {
  id          String   @id @default(uuid())
  userId      String
  feature     String
  description String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
}

model Layanan {
  id                String   @id @default(uuid())
  icon              String
  nama              String
  slug              String   @unique
  deskripsi_singkat String
  home              Boolean?
}

model PendaftaranAmbulansSoetomo {
  id        String   @id @default(uuid())
  userId    String
  keluhan   String
  address   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

enum TipePasien {
  JKN
  NON_JKN
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
